{
  "name": "@fastgo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --experimental-strip-types src/db/cli.ts",
    "staff:totp": "node --experimental-strip-types src/auth/staff-totp-main.ts",
    "test": "vitest run && node scripts/test-shifted.mjs",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@fastgo/contract": "workspace:*",
    "@fastgo/domain": "workspace:*",
    "@fastgo/i18n": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-fastify": "^12.5.0",
    "@node-rs/argon2": "^2.2.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fastgo/config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "testcontainers": "^12.2.1",
    "tsup": "^8.5.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
