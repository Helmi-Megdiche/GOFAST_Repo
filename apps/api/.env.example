# Fake values only. Copy to .env.local (git-ignored); the API reads the real environment.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
WS_PORT=4001
WORKER_PORT=4002
# true or false, nothing else
TRUST_PROXY=false
# Fake local values. Real ones live only in the server environment, never in git.
# api: login fastgo_app. worker: login fastgo_worker.
DATABASE_URL=postgres://fastgo_app:change-me@localhost:5432/fastgo
REDIS_URL=redis://localhost:6379
# At least 32 characters; key of the HMACs kept in Redis.
AUTH_SECRET=fake-local-secret-change-me-0123456789
# Origins allowed to write with a session cookie, comma separated.
ALLOWED_ORIGINS=http://localhost:3000
# Staff password sign-in: false (refused in production, T60).
STAFF_SIGNIN=false
# Only "fake" exists; it sends nothing and is refused in production.
SMS_PROVIDER=fake
