# Fake values only. Copy to .env.local (git-ignored); the API reads the real environment.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
WS_PORT=4001
WORKER_PORT=4002
# Number of reverse proxies in front of the api (0 = none, 1 = one proxy). Never `true`.
TRUST_PROXY=0
# Fake local values. Real ones live only in the server environment, never in git.
# api: login fastgo_app. worker: login fastgo_worker.
DATABASE_URL=postgres://fastgo_app:change-me@localhost:5432/fastgo
REDIS_URL=redis://localhost:6379
# At least 32 characters; key of the HMACs kept in Redis.
AUTH_SECRET=fake-local-secret-change-me-0123456789
# Origins allowed to write with a session cookie, comma separated: the web (3000) and the back-office (127.0.0.1:3001, GH-25).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3001
# The key of the back-office second-factor secrets (AES-256-GCM): 32 bytes in base64. FAKE value: a real one lives only in the server
# environment (required in production, T60). Make one with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
TOTP_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
# Only "fake" exists; it sends nothing and is refused in production.
SMS_PROVIDER=fake
