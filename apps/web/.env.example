# Public address of the site. Fake value: the domain is not decided yet.
# Used for the canonical and hreflang links. Falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=https://fastgo.example

# Fake network time of the mock data layer, in ms. Default 350. The e2e build sets 25.
NEXT_PUBLIC_FG_MOCK_DELAY_MS=350

# API (#20). Empty NEXT_PUBLIC_API_DOMAINS = everything on the mock data layer.
# A comma list switches domains one by one: auth, orders, pricing, account. An unknown name fails.
NEXT_PUBLIC_API_DOMAINS=
# Server-side only (never NEXT_PUBLIC_): where Next forwards /v1/* to. The browser stays same origin.
API_ORIGIN=http://localhost:4000
