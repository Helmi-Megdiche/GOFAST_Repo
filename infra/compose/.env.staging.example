# Fake values: staging override run on a laptop. The real file lives on the server (/opt/gofast/secrets),
# never in git. Run: docker compose -f compose.yaml -f compose.staging.yaml --env-file .env.staging.example up -d --build --wait
# No COMPOSE_PROFILES: db-setup is not started on staging (and the override removes it).
POSTGRES_PASSWORD=fake-postgres-superuser
FASTGO_MIGRATOR_PASSWORD=fake-migrator
FASTGO_APP_PASSWORD=fake-app
FASTGO_READONLY_PASSWORD=fake-readonly
FASTGO_WORKER_PASSWORD=fake-worker
PGBOUNCER_AUTH_PASSWORD=fake-pgbouncer-auth
REDIS_PASSWORD=fake-redis
S3_ACCESS_KEY=fakeaccesskey
S3_SECRET_KEY=fakesecretkey-change-me
AUTH_SECRET=fake-auth-secret-at-least-32-characters-long
# Back-office second-factor key (32 bytes, base64). Fake: a real one lives only in the server env.
TOTP_KEY=TViMLQmLmXWqQxN0SOakZZFMXtiX6oTNYch7s49czaQ=
# SMS_PROVIDER=fake is refused in production, so staging runs development until a provider exists.
APP_ENV=development

PG_PORT=15432
PGBOUNCER_PORT=16432
REDIS_PORT=16379
S3_PORT=18333
WEB_PORT=13000
API_PORT=14000

# Domain not decided yet (STAGING_DOMAIN). Locally: a fake name, resolved with curl --resolve.
STAGING_DOMAIN=staging.gofast.test
CADDY_TLS=internal
CADDY_BIND=127.0.0.1
HTTP_PORT=18080
HTTPS_PORT=18443
# Fake login: gofast / fake-staging-password. Single quotes: the hash holds $ signs.
STAGING_USER=gofast
STAGING_PASSWORD_HASH='$2a$14$19Z5ZCZw373qkplCcFvssOO86Nwz9GjuUUM7KN6ueuexzTvfLAZu2'
