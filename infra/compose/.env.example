# Fake values only. Laptop: docker compose --env-file .env.example up -d
# Staging: the real file lives on the server (/opt/gofast/secrets), never in git.
COMPOSE_PROFILES=setup

POSTGRES_PASSWORD=fake-postgres-superuser
FASTGO_MIGRATOR_PASSWORD=fake-migrator
FASTGO_APP_PASSWORD=fake-app
FASTGO_READONLY_PASSWORD=fake-readonly
FASTGO_WORKER_PASSWORD=fake-worker
PGBOUNCER_AUTH_PASSWORD=fake-pgbouncer-auth
REDIS_PASSWORD=fake-redis
S3_ACCESS_KEY=fakeaccesskey
S3_SECRET_KEY=fakesecretkey-change-me

# Host ports (127.0.0.1 only), away from the usual 5432 and 6379 that a local install may hold.
PG_PORT=15432
PGBOUNCER_PORT=16432
REDIS_PORT=16379
S3_PORT=18333

# Apps (fake). AUTH_SECRET needs 32 characters or more. APP_ENV=development allows the fake SMS sender.
AUTH_SECRET=fake-auth-secret-at-least-32-characters-long
APP_ENV=development
WEB_PORT=13000
API_PORT=14000

# Caddy (the only public door). The laptop binds to 127.0.0.1 and goes through Caddy like staging, so
# the api trusts exactly one hop (TRUST_PROXY=1). api (14000) and web (13000) stay reachable directly on
# 127.0.0.1 for tools; there the forwarded header is client-written: use the Caddy address to test limits.
# Ports 18080/18443 because 80, 443 and 8080 are often taken on a laptop. Open https://localhost:18443/fr (the
# certificate is Caddy's own: curl -k, or trust it from the caddy_data volume).
TRUST_PROXY=1
CADDY_BIND=127.0.0.1
HTTP_PORT=18080
HTTPS_PORT=18443
